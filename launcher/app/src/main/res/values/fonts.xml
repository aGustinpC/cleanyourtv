<?xml version="1.0" encoding="utf-8"?>
<!-- The UI fonts, looked up through these strings so a locale can swap in a system family: Outfit has no
     glyphs for most Vietnamese accented letters, so values-vi points them at the system sans-serif (#833).
     This copy uses Space Grotesk instead of Outfit (licence: launcher/FONT-LICENSE-SPACEGROTESK-OFL.txt). -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ReferenceType">
    <string name="font_body" translatable="false">@font/spacegrotesk</string>
    <string name="font_regular" translatable="false">@font/spacegrotesk_regular</string>
    <string name="font_light" translatable="false">@font/spacegrotesk_light</string>
    <string name="font_extralight" translatable="false">@font/spacegrotesk_extralight</string>
    <string name="font_medium" translatable="false">@font/spacegrotesk_medium</string>
</resources>
