<?xml version="1.0" encoding="utf-8"?>
<!-- Space Grotesk at weight 300, built once per process, as the outfit_* families are. Its axis runs 300 to 700, so
     the extralight family is its lightest instance. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <font
        android:font="@font/spacegrotesk"
        android:fontStyle="normal"
        android:fontWeight="300"
        android:fontVariationSettings="'wght' 300"
        tools:targetApi="28" />
</font-family>